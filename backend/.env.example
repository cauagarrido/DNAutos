PORT=3000
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:5110
PUBLIC_API_URL=http://localhost:3000
# Use one domain in production. Trust exactly one reverse proxy only when configured.
TRUST_PROXY=0
SERVE_FRONTEND=false

# Supabase Auth: publishable key, NEVER a service_role key in the frontend.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Supabase transaction pooler (port 6543) in serverless, session pooler for a VPS.
DATABASE_URL=
# PEM CA certificate downloaded from your Supabase project; use literal \n if needed.
DATABASE_CA_CERT=
# Generate separately: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_ENCRYPTION_KEY=
AUTH_RATE_SECRET=
REQUIRE_PHONE_MFA=true

# Keep disabled until the contracted ANYCAR specification is validated end to end.
CHECKOUT_ENABLED=false
ANYCAR_CONTRACT_VERIFIED=false
ANYCAR_API_URL=
ANYCAR_API_KEY=
ANYCAR_REPORT_TYPES=

MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_COLLECTOR_ID=
MERCADO_PAGO_LIVE_MODE=false
# Price is fixed to 5000 cents in server AND database. No browser-supplied price.

# Public HTTPS contact address (WhatsApp/support portal); required to enable checkout.
SUPPORT_URL=
CRON_SECRET=
FIPE_API_URL=https://fipe.parallelum.com.br/api/v2
FIPE_API_KEY=
